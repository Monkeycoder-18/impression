{
    "key": "group_service",
    "title": "Service Page",
    "fields": [
        {
            "key": "field_service_hero_tab",
            "label": "Hero",
            "name": "",
            "type": "tab",
            "instructions": "The banner at the top of the page. The big heading uses the page title, so edit that in the Title field above."
        },
        {
            "key": "field_service_hero_badge",
            "label": "Badge",
            "name": "service_hero_badge",
            "type": "text"
        },
        {
            "key": "field_service_hero_subtitle",
            "label": "Subtitle",
            "name": "service_hero_subtitle",
            "type": "textarea",
            "rows": 3,
            "instructions": "Leave empty to use the page excerpt, then the default text."
        },
        {
            "key": "field_service_hero_image",
            "label": "Image",
            "name": "service_hero_image",
            "type": "image",
            "return_format": "array",
            "preview_size": "medium",
            "instructions": "Leave empty to use the featured image."
        },
        {
            "key": "field_service_hero_float_badge",
            "label": "Floating badge",
            "name": "service_hero_float_badge",
            "type": "text"
        },
        {
            "key": "field_service_hero_btn1_text",
            "label": "Primary button text",
            "name": "service_hero_btn1_text",
            "type": "text"
        },
        {
            "key": "field_service_hero_btn1_link",
            "label": "Primary button link",
            "name": "service_hero_btn1_link",
            "type": "text"
        },
        {
            "key": "field_service_hero_btn2_text",
            "label": "Secondary button text",
            "name": "service_hero_btn2_text",
            "type": "text"
        },
        {
            "key": "field_service_hero_btn2_link",
            "label": "Secondary button link",
            "name": "service_hero_btn2_link",
            "type": "text"
        },
        {
            "key": "field_service_stats_tab",
            "label": "Stats bar",
            "name": "",
            "type": "tab",
            "instructions": "The row of numbers under the hero. Leave empty to keep the defaults."
        },
        {
            "key": "field_service_stats",
            "label": "Stats",
            "name": "service_stats",
            "type": "repeater",
            "layout": "table",
            "button_label": "Add a stat",
            "sub_fields": [
                {
                    "key": "field_service_stat_number",
                    "label": "Number",
                    "name": "number",
                    "type": "text"
                },
                {
                    "key": "field_service_stat_label",
                    "label": "Label",
                    "name": "label",
                    "type": "text"
                }
            ]
        },
        {
            "key": "field_service_intro_tab",
            "label": "Intro",
            "name": "",
            "type": "tab",
            "instructions": "The split image + text block (\"Why Choose...\")."
        },
        {
            "key": "field_service_intro_image",
            "label": "Image",
            "name": "service_intro_image",
            "type": "image",
            "return_format": "array",
            "preview_size": "medium"
        },
        {
            "key": "field_service_intro_badge",
            "label": "Badge",
            "name": "service_intro_badge",
            "type": "text"
        },
        {
            "key": "field_service_intro_heading",
            "label": "Heading",
            "name": "service_intro_heading",
            "type": "text"
        },
        {
            "key": "field_service_intro_paragraph_1",
            "label": "Paragraph 1",
            "name": "service_intro_paragraph_1",
            "type": "textarea",
            "rows": 4,
            "instructions": "Leave a blank line between paragraphs to add more than one."
        },
        {
            "key": "field_service_intro_paragraph_2",
            "label": "More text",
            "name": "service_intro_paragraph_2",
            "type": "wysiwyg",
            "tabs": "visual",
            "toolbar": "basic",
            "media_upload": 0,
            "instructions": "Optional. More paragraphs or a bullet list."
        },
        {
            "key": "field_service_intro_checks",
            "label": "Check items",
            "name": "service_intro_checks",
            "type": "repeater",
            "layout": "table",
            "button_label": "Add an item",
            "sub_fields": [
                {
                    "key": "field_service_intro_check_text",
                    "label": "Text",
                    "name": "text",
                    "type": "text"
                }
            ]
        },
        {
            "key": "field_service_sections_tab",
            "label": "Details",
            "name": "",
            "type": "tab",
            "instructions": "The main content of the page, one block per topic (e.g. \"Treatments for Oily Skin\"). Each block can have text, a photo, before/after photos and cards."
        },
        {
            "key": "field_service_sections",
            "label": "Sections",
            "name": "service_sections",
            "type": "repeater",
            "layout": "block",
            "button_label": "Add a section",
            "sub_fields": [
                {
                    "key": "field_service_section_heading",
                    "label": "Heading",
                    "name": "heading",
                    "type": "text"
                },
                {
                    "key": "field_service_section_body",
                    "label": "Text",
                    "name": "body",
                    "type": "wysiwyg",
                    "tabs": "visual",
                    "toolbar": "basic",
                    "media_upload": 0
                },
                {
                    "key": "field_service_section_image",
                    "label": "Photo",
                    "name": "image",
                    "type": "image",
                    "return_format": "array",
                    "preview_size": "medium",
                    "instructions": "Optional. Shown beside the text."
                },
                {
                    "key": "field_service_section_gallery",
                    "label": "Before / after photos",
                    "name": "gallery",
                    "type": "gallery",
                    "return_format": "array",
                    "preview_size": "thumbnail",
                    "instructions": "Optional. Each photo shows its caption underneath (set the caption in the media library)."
                },
                {
                    "key": "field_service_section_items_heading",
                    "label": "Cards heading",
                    "name": "items_heading",
                    "type": "text",
                    "instructions": "Optional, e.g. \"Recommended Treatments\"."
                },
                {
                    "key": "field_service_section_items",
                    "label": "Cards",
                    "name": "items",
                    "type": "repeater",
                    "layout": "block",
                    "button_label": "Add a card",
                    "instructions": "Optional. Treatments (with duration) or other short items.",
                    "sub_fields": [
                        {
                            "key": "field_service_section_item_image",
                            "label": "Photo",
                            "name": "image",
                            "type": "image",
                            "return_format": "array",
                            "preview_size": "thumbnail"
                        },
                        {
                            "key": "field_service_section_item_title",
                            "label": "Title",
                            "name": "title",
                            "type": "text"
                        },
                        {
                            "key": "field_service_section_item_meta",
                            "label": "Duration",
                            "name": "meta",
                            "type": "text",
                            "instructions": "Optional, e.g. \"90 mins\"."
                        },
                        {
                            "key": "field_service_section_item_text",
                            "label": "Description",
                            "name": "text",
                            "type": "textarea",
                            "rows": 3
                        }
                    ]
                }
            ]
        },
        {
            "key": "field_service_audience_tab",
            "label": "Who is this for",
            "name": "",
            "type": "tab",
            "instructions": "Optional concern / skin-type cards. Leave empty to hide the section."
        },
        {
            "key": "field_service_audience_heading",
            "label": "Heading",
            "name": "service_audience_heading",
            "type": "text"
        },
        {
            "key": "field_service_audience_subheading",
            "label": "Subheading",
            "name": "service_audience_subheading",
            "type": "text"
        },
        {
            "key": "field_service_audience_cards",
            "label": "Cards",
            "name": "service_audience_cards",
            "type": "repeater",
            "layout": "block",
            "button_label": "Add a card",
            "sub_fields": [
                {
                    "key": "field_service_audience_card_image",
                    "label": "Image",
                    "name": "image",
                    "type": "image",
                    "return_format": "array",
                    "preview_size": "medium"
                },
                {
                    "key": "field_service_audience_card_title",
                    "label": "Title",
                    "name": "title",
                    "type": "text"
                },
                {
                    "key": "field_service_audience_card_desc",
                    "label": "Description",
                    "name": "description",
                    "type": "text"
                }
            ]
        },
        {
            "key": "field_service_treatments_tab",
