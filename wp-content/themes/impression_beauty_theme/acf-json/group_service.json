        },
        {
            "key": "field_service_treatments_heading",
            "label": "Heading",
            "name": "service_treatments_heading",
            "type": "text"
        },
        {
            "key": "field_service_treatments_subheading",
            "label": "Subheading",
            "name": "service_treatments_subheading",
            "type": "text"
        },
